{% import "macros.tera" as macros %}
/*
{{ir.license_text}}
*/
// Generated from SVD {{ir.version}}, with svd2pac {{svd2pac_version}} on {{now}}
{%- if tracing %}
#![cfg_attr(not(feature = "tracing"), no_std)]
{%- else %}
#![no_std]
{%- endif %} {# tracing #}
#![allow(non_camel_case_types)]
#![doc = "{{ir.device.description | svd_description_to_doc}}"]

// Re-export the shared `common` crate and bring its traits into scope so the
// public API matches the single-package generation mode.
#[doc(hidden)]
pub use common;
#[doc(hidden)]
pub use common::{
    AsPtr as _, Modify as _, NoBitfieldReg as _, Read as _, Reg as _, RegisterValue as _,
    ResetValue as _, Write as _,
};

{% if tracing %}
#[cfg(feature = "tracing")]
pub mod reg_name;
#[cfg(feature = "tracing")]
pub use common::tracing;
{% endif %} {# tracing #}

{# Re-export each peripheral crate's public items behind its       #}
{# feature flag. We re-export the peripheral module, its struct  (rather than glob importing)   #}
{% for peri_mod_name, peri in ir.device.peripheral_mod -%}
{%- if not (peri.derived_from is string) -%}
{%- set feature_name = peri.name | lower -%}
#[cfg(feature = "{{feature_name}}")]
pub use {{package_name}}_{{peri.module_id}}::{ {{peri.module_id}}, {{peri.struct_id}} };
{%- set crate_struct = package_name ~ "_" ~ peri.module_id ~ "::" ~ peri.struct_id -%}
#[cfg(feature = "{{feature_name}}")]
{%- if peri.base_addr | length == 1 %}
pub const {{ peri.name | upper }}: {{crate_struct}} = {{crate_struct}}::_new({{ peri.base_addr[0] | to_hex }}u32 as _);
{% else %}
pub const {{ peri.name | upper }}:[{{crate_struct}};{{ peri.base_addr | length }}] = [{%- for addr in peri.base_addr %}  {{crate_struct}}::_new({{ addr | to_hex }}u32 as _), {% endfor -%}];
{% endif -%}
{% endif -%}
{%- endfor %}

{# Aurix CSFR (core special function registers). In workspace mode each CSFR   #}
{# module is emitted as its own peripheral crate and re-exported here.          #}
{% if ir_csfr %}
{% for peri_mod_name, peri in ir_csfr.device.peripheral_mod -%}
{%- set module_name = peri.module_id -%}
{%- set module_struct = peri.struct_id | to_struct_id -%}
{%- set feature_name = peri.name | lower -%}
#[cfg(feature = "{{feature_name}}")]
pub use {{package_name}}_{{module_name}}::{ {{module_name}}, {{module_struct}} };
{% endfor -%}
{% endif %}



{# Aurix CSFR instance constants (types are re-exported above).                 #}
{% if ir_csfr %}
{% for name,p in ir_csfr.device.peripheral_mod %}
{%- set module_struct = p.struct_id | to_struct_id -%}
{%- set full_path_struct = package_name ~ "_" ~ p.module_id ~ "::" ~ module_struct -%}
{%- set module_name = p.module_id -%}
{%- set feature_name = p.name | lower -%}
#[cfg(feature = "{{feature_name}}")]
{%- if p.base_addr | length == 1 %}
pub const {{name | upper}}: {{full_path_struct}} = {{full_path_struct}}::_new({{p.base_addr[0] | to_hex }}u32 as _);
{% else %}
pub const {{name | upper}}:[{{full_path_struct}};{{ p.base_addr | length }}] = [{%- for addr in p.base_addr %}  {{full_path_struct}}::_new({{addr | to_hex }}u32 as _), {% endfor -%}];
{% endif %}
{%- endfor -%}
{% endif %}

{#- Block to support Cortex-m-rt #}
{% if target=="CortexM" -%}
{{ macros::cortex_m_interrupt_table(ir=ir) }}
{{ macros::cortex_m_peripherals_struct(ir=ir) }}
{% endif -%}
