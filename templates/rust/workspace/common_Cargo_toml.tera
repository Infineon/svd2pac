# Generated from SVD {{ir.version}}, with svd2pac {{svd2pac_version}} on {{now}}

[package]
name = "common"
version = "0.0.1"
authors = ["Infineon developers"]
edition = "2021"
rust-version = "1.70"
description = "Common register access primitives for {{package_name}}"
categories = ["embedded","hardware-support","no-std","no-std::no-alloc"]

[lib]
test = false
bench = false
{% if tracing %}
[features]
tracing = []
tracing_dummy = []
{% endif %}
