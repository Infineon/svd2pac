{% import "macros.tera" as macros -%}
{% for line in  ir.license_text | prepend_lines(prefix="# ") -%}
{{line}}
{% endfor -%}
# Generated from SVD {{ir.version}}, with svd2pac {{svd2pac_version}} on {{now}}

[workspace]
members = [
    "common",
    {%- for peri_mod_name, peri in ir.device.peripheral_mod %}
    {%- if not (peri.derived_from is string) %}
    "peripherals/{{peri.module_id}}",
    {%- endif %}
    {%- endfor %}
    {%- if ir_csfr %}
    {%- for peri_mod_name, peri in ir_csfr.device.peripheral_mod %}
    {%- if not (peri.derived_from is string) %}
    "peripherals/{{peri.module_id}}",
    {%- endif %}
    {%- endfor %}
    {%- endif %}
]
resolver = "2"

[package]
name = "{{package_name}}"
version = "0.0.1"
authors = ["Infineon developers"]
edition = "2021"
rust-version = "1.70"
description = "{{description}}"
keywords = ["no_std", "infineon"{%- if target=="Aurix" -%}, "aurix"{%- endif -%}]
categories = ["embedded","hardware-support","no-std","no-std::no-alloc"]
license-file = "LICENSE.txt"

[lib]
test = false
bench = false

[dependencies]
common = { path = "./common" }
{%- for peri_mod_name, peri in ir.device.peripheral_mod %}
{%- if not (peri.derived_from is string) %}
{{package_name}}_{{peri.module_id}} = { path = "./peripherals/{{peri.module_id}}", optional = true }
{%- endif %}
{%- endfor %}
{%- if ir_csfr %}
{%- for peri_mod_name, peri in ir_csfr.device.peripheral_mod %}
{%- if not (peri.derived_from is string) %}
{{package_name}}_{{peri.module_id}} = { path = "./peripherals/{{peri.module_id}}", optional = true }
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if tracing %}
phf = { version = "0.11", features = ["macros"], optional = true }
{%- endif %}
{%- if target=="CortexM" %}
cortex-m-rt = { version = "0.7", optional = true }
cortex-m = "0.7.6"
{%- endif %}

[features]
{{ macros::cargo_features(ir=ir, tracing=tracing, target=target, workspace_mode=true, package_name=package_name, ir_csfr=ir_csfr | default(value=false)) }}

[package.metadata.docs.rs]
features = ["all"{% if target=="CortexM" %},"rt"{%endif%}]
