{% for line in  ir.license_text | prepend_lines(prefix="# ") -%}
{{line}}
{% endfor -%}
# Generated from SVD {{ir.version}}, with svd2pac {{svd2pac_version}} on {{now}}

[package]
name = "{{package_name}}_{{peri.module_id}}"
version = "0.0.1"
authors = ["Infineon developers"]
edition = "2021"
rust-version = "1.70"
description = "{{peri.name}} peripheral of {{package_name}}"
categories = ["embedded","hardware-support","no-std","no-std::no-alloc"]

[lib]
test = false
bench = false

[dependencies]
common = { path = "../../common" }
{%- for dep_mod in referenced_crates %}
{{package_name}}_{{dep_mod}} = { path = "../../peripherals/{{dep_mod}}" }
{%- endfor %}
