{# Generated core register function #}
{%- component register_core_func(types_mod: string, reg: map, base_addr: integer) -%}
{%- set reg_struct = reg.name | to_struct_id -%}
{%- set reg_struct_name = types_mod ~ "::" ~  reg_struct  -%}
{%- set reg_mod_name = reg.name | to_mod_id -%}
    {%- set reg_addr = (base_addr + reg.offset) | to_hex -%}
#[doc = r"{{reg.description | svd_description_to_doc}}"]
#[inline(always)]
{% if reg.dim == 1 -%}
pub const fn {{reg.name | to_func_id }}(&self) -> crate::common::RegCore<{{reg_struct_name}}, {{reg_addr}},{{reg.reset_value}}> {
    unsafe { crate::common::RegCore::new() }
}
{%- else -%}
{%- for index in range(end=reg.dim) -%}
pub const fn {{(reg.name~index) | to_func_id }}(&self)-> crate::common::RegCore<{{reg_struct_name}}, {{(base_addr + reg.offset + index * reg.dim_increment) | to_hex }},{{reg.reset_value}}> {
    unsafe { crate::common::RegCore::new() }
}
{% endfor -%}
{%- endif -%}
{%- endcomponent register_core_func -%}


{# Generated core cluster unrolled into register function #}
{%- component cluster_register_core_func(types_mod: string, reg: map, base_addr: integer, cluster_index: integer, cluster: map) -%}
{%- set reg_struct = (cluster.name~"_"~reg.name) | to_struct_id -%}
{%- set reg_struct_name = types_mod ~ "::" ~  reg_struct  -%}
    {%- set reg_addr = (base_addr + reg.offset) | to_hex -%}
#[doc = r"{{reg.description | svd_description_to_doc}}"]
#[inline(always)]
{% if reg.dim == 1 -%}
{% if cluster.dim == 1 -%}
pub const fn {{(cluster.name~"_"~reg.name) | to_func_id }}(&self) -> crate::common::RegCore<{{reg_struct_name}}, {{reg_addr}},{{reg.reset_value}}> {
    unsafe { crate::common::RegCore::new() }
}
{%- else -%}
pub const fn {{(cluster.name~"_"~reg.name~cluster_index) | to_func_id }}(&self) -> crate::common::RegCore<{{reg_struct_name}}, {{reg_addr}},{{reg.reset_value}}> {
    unsafe { crate::common::RegCore::new() }
}
{%- endif -%}
{%- else -%}
{%- for reg_index in range(end=reg.dim) -%}
{% if cluster.dim == 1 -%}
pub const fn {{(cluster.name~"_"~reg.name~reg_index) | to_func_id }}(&self)-> crate::common::RegCore<{{reg_struct_name}}, {{(base_addr + reg.offset + reg_index * reg.dim_increment) | to_hex }},{{reg.reset_value}}> {
    unsafe { crate::common::RegCore::new() }
}
{%- else -%}
pub const fn {{(cluster.name~"_"~reg.name~"_"~cluster_index~"_"~reg_index) | to_func_id }}(&self)-> crate::common::RegCore<{{reg_struct_name}}T, {{(base_addr + reg.offset + reg_index * reg.dim_increment) | to_hex }},{{reg.reset_value}}> {
    unsafe { crate::common::RegCore::new() }
}
{%- endif -%}
{% endfor -%}
{%- endif -%}
{%- endcomponent cluster_register_core_func -%}

{# Unroll the cluster register for aurix csfr #}
{%- component cluster_func_csfr(types_mod: string, cluster: map, base_addr: integer) -%}
{%- set cluster_struct_id = cluster.name | to_struct_id -%}
{%- set cluster_base_addr = base_addr + cluster.offset -%}
#[doc = "{{cluster.description | svd_description_to_doc}}"]
{%- if cluster.dim == 1 %}
{% for register_name,reg in cluster.registers -%}
{{<cluster_register_core_func types_mod="self" reg={reg} base_addr={cluster_base_addr} cluster_index={0} cluster={cluster} />}}
{% endfor -%}
{%- else %}
{%- for index in range(end=cluster.dim) -%}
{%- set current_cluster_addr = cluster_base_addr + index * cluster.dim_increment -%}
{% for register_name,reg in cluster.registers -%}
{{<cluster_register_core_func types_mod="self" reg={reg} base_addr={current_cluster_addr} cluster_index={index} cluster={cluster} />}}
{% endfor -%}
{% endfor -%}
{%- endif -%}
{%- endcomponent cluster_func_csfr -%}


{%- component register_core_struct(reg: map, reg_name: string = "") -%}
{%-if reg_name %}
{%- set reg_struct_name = reg_name | to_struct_id -%}
{%- set reg_mod_name = reg_name | to_mod_id -%}
{%- else -%}
{%- set reg_struct_name = reg.name | to_struct_id -%}
{%- set reg_mod_name = reg.name | to_mod_id -%}
{%- endif -%}


{{<doc_attribute documentation={reg.description} />}}
#[derive(Copy, Clone, Eq, PartialEq)]
pub struct {{reg_struct_name}} {
    pub(crate) data: {{<reg_size2num_type bit_size={reg.size} />}},
    pub(crate) mask: {{<reg_size2num_type bit_size={reg.size} />}}
}

impl crate::common::RegisterValue for {{reg_struct_name}} {
    type DataType = {{<reg_size2num_type bit_size={reg.size} />}};

    fn inner_mut(&mut self) -> (&mut Self::DataType, &mut Self::DataType) {
        (&mut self.data, &mut self.mask)
    }

    fn inner(&self) -> (Self::DataType, Self::DataType) {
        (self.data, self.mask)
    }

    fn new(data: Self::DataType) -> Self {
        Self {
            data,
            mask: 0x0,
        }
    }
}




{% if reg.access == "R" or reg.access == "RW" -%}
unsafe impl crate::common::ReadCore for {{reg_struct_name}} {}
{% endif -%}
{% if reg.access == "W" or reg.access == "RW" -%}
unsafe impl crate::common::WriteCore for {{reg_struct_name}} {}
{% endif -%}



{% if not reg.fields %}
impl crate::common::NoBitfieldReg for {{reg_struct_name}} {}
{% else -%}
impl {{reg_struct_name}} {
    {%- for field_name,field in reg.fields %}
    {{<doc_attribute documentation={field.description} />}}
    #[inline(always)]
    {%- if field.dim > 1 -%}
    pub fn {{field.name | to_func_id }}(self,index:u8) -> {{<bitfield_type field={field} reg_struct_name={reg_struct_name} reg_mod_name={reg_mod_name} turbofish={false} />}} {
        assert!(index < {{field.dim}});
        {{<bitfield_type field={field} reg_struct_name={reg_struct_name} reg_mod_name={reg_mod_name} turbofish={true} />}}::from_register(self,index)
     
    }
    {%- for func_name in field.dim_index %}
    #[inline(always)]
    pub fn {{func_name | to_func_id }}(self) -> {{<bitfield_type field={field} reg_struct_name={reg_struct_name} reg_mod_name={reg_mod_name} turbofish={false} />}} {
        {{<bitfield_type field={field} reg_struct_name={reg_struct_name} reg_mod_name={reg_mod_name} turbofish={true} />}}::from_register(self,{{loop.index0}})
    }
    {% endfor %}
    {%- else %}
    pub fn {{field.name | to_func_id }}(self) -> {{<bitfield_type field={field} reg_struct_name={reg_struct_name} reg_mod_name={reg_mod_name} turbofish={false} />}} {
        {{<bitfield_type field={field} reg_struct_name={reg_struct_name} reg_mod_name={reg_mod_name} turbofish={true} />}}::from_register(self,0)
    }
    {%- endif -%}
    {%- endfor %}
}
{% endif -%}

{% if reg.has_enumerated_fields -%}
pub mod {{reg_mod_name}} {
    #[allow(unused_imports)]
    use crate::common;
    #[allow(unused_imports)]
    use crate::common::{
        AsPtr as _,  CastFrom, EnumBitfieldStruct, NoBitfieldReg as _, Read as _, Reg as _, RegisterValue as _,
        ResetValue as _, Write as _,
    };
    {% for field_name,field in reg.fields -%}
    {%- for enum_type in field.enum_types -%}
    {%- set enum_name_type= enum_type.name | to_struct_id %}
    #[derive(Clone, Copy, Eq, PartialEq, Ord, PartialOrd)]
    #[repr(transparent)]
    pub struct {{enum_name_type}}({{<reg_size2num_type bit_size={enum_type.size} />}});
    
    impl {{enum_name_type}} {
        pub fn new(value: {{<reg_size2num_type bit_size={enum_type.size} />}}) -> Self {
            Self(value)
        }
    }

    impl crate::common::EnumBitfieldStruct for {{enum_name_type}} {
        type RegNumberT = {{<reg_size2num_type bit_size={enum_type.size} />}};

        fn value(&self) -> Self::RegNumberT {
            self.0
        }
    }

    impl From<{{<reg_size2num_type bit_size={enum_type.size} />}}> for {{enum_name_type}} {
        #[inline(always)]
        fn from(value: {{<reg_size2num_type bit_size={enum_type.size} />}}) -> Self {
            Self(value)
        }
    }

    impl From<{{enum_name_type}}> for u64 {
        #[inline(always)]
        fn from(value: {{enum_name_type}}) -> Self {
            value.value().into()
        }
    }

    impl CastFrom<u64> for {{enum_name_type}} {
        #[inline(always)]
        fn cast_from(val: u64) -> Self {
            Self({{<reg_size2num_type bit_size={enum_type.size} />}}::cast_from(val))
        }
    }
    impl {{enum_name_type}} {
        {%- for val in enum_type.values %}
        {{<doc_attribute documentation={val.description} />}}
        pub const {{val.name | to_enumerated_const_id }}:Self =Self({{val.value}});
        {%- endfor %}
    }
    {%- endfor -%}
    {% endfor %}
}
{%- endif -%}
{%- endcomponent register_core_struct -%}


