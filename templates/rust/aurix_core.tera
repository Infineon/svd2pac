// Generated from SVD {{ir.version}}, with svd2pac {{svd2pac_version}} on {{now}}

#![allow(clippy::identity_op)]
#![allow(clippy::module_inception)]
#![allow(clippy::derivable_impls)]
#[allow(unused_imports)]
use crate::common;
#[allow(unused_imports)]
use crate::common::{
    AsPtr as _, NoBitfieldReg as _, ReadCore as _, Reg as _, RegisterValue as _,
    ResetValue as _, WriteCore as _,
};
#[doc = r"{{peri.description | svd_description_to_doc}}"]
{% set peri_struct = peri.struct_id | to_struct_id -%}
{% set peri_base_addr = peri.base_addr[0]  -%}
unsafe impl ::core::marker::Send for super::{{peri_struct}}  {}
unsafe impl ::core::marker::Sync for super::{{peri_struct}}  {}
impl super::{{peri_struct}} {
{%- for register_name,reg in peri.registers %}
{{<register_core_func types_mod="self" reg={reg} base_addr={peri_base_addr} />}}
{% endfor -%}
{% for cluster_name,cluster in peri.clusters -%}
{{<cluster_func_csfr types_mod="self" cluster={cluster} base_addr={peri_base_addr} />}}
{% endfor %}

}
{% for register_name,reg in peri.registers -%}
{{<register_core_struct reg={reg} />}}
{% endfor %}
{% for cluster_name,cluster in peri.clusters -%}
{% for register_name,reg in cluster.registers -%}
{% set cluster_reg_name = cluster.name~"_"~reg.name  -%}
{{<register_struct reg={reg} reg_name={cluster_reg_name} />}}
{% endfor %}
{% endfor %}





